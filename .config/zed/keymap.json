[
    {
        "context": "Workspace",
        "bindings": {
            "ctrl-tab": "pane::ActivateNextItem",
            "ctrl-shift-tab": "pane::ActivatePrevItem",
            "ctrl-1": ["pane::ActivateItem", 0],
            "ctrl-2": ["pane::ActivateItem", 1],
            "ctrl-3": ["pane::ActivateItem", 2],
            "ctrl-4": ["pane::ActivateItem", 3],
            "ctrl-5": ["pane::ActivateItem", 4],
            "ctrl-6": ["pane::ActivateItem", 5],
            "ctrl-7": ["pane::ActivateItem", 6],
            "ctrl-8": ["pane::ActivateItem", 7],
            "ctrl-9": "pane::ActivateLastItem",
            "ctrl-w": "pane::CloseActiveItem",
            "ctrl-t": "workspace::NewCenterTerminal",
            "ctrl-g -": "pane::SplitDown",
            "ctrl-g \\": "pane::SplitRight",
            "ctrl-g h": "workspace::ActivatePaneLeft",
            "ctrl-g j": "workspace::ActivatePaneDown",
            "ctrl-g k": "workspace::ActivatePaneUp",
            "ctrl-g l": "workspace::ActivatePaneRight",
            "ctrl-g z": "workspace::ToggleZoom",
            // --- AI用プロンプトのコピー ---
            "ctrl-g a": [
                "task::Spawn",
                { "task_name": "copy-filepath-for-ai" }
            ],
            "ctrl-g s": [
                "task::Spawn",
                { "task_name": "copy-filepath#range-for-ai" }
            ],
            "ctrl-q": "zed::Quit",
            "ctrl-shift-p": "command_palette::Toggle",
            "ctrl--": "zed::DecreaseBufferFontSize",
            "ctrl-=": "zed::IncreaseBufferFontSize",
            "ctrl-n": "workspace::NewWindow"
        }
    },
    {
        "context": "Terminal",
        "bindings": {
            "ctrl-tab": "pane::ActivateNextItem",
            "ctrl-shift-tab": "pane::ActivatePrevItem",
            "ctrl-w": "pane::CloseActiveItem",
            "ctrl-t": "workspace::NewCenterTerminal",
            "ctrl-g -": "pane::SplitDown",
            "ctrl-g \\": "pane::SplitRight",
            "ctrl-g h": "workspace::ActivatePaneLeft",
            "ctrl-g j": "workspace::ActivatePaneDown",
            "ctrl-g k": "workspace::ActivatePaneUp",
            "ctrl-g l": "workspace::ActivatePaneRight",
            "ctrl-g z": "workspace::ToggleZoom"
        }
    }
]
